{
  "$schema": "https://opencode.ai/config.json",
  // 项目级覆盖：本项目用不上 adb 与 playwright，两个 MCP 在此关闭。
  // 注意：同名 server 的项目级条目会整体替换全局条目，故 type/command 等必填字段必须重复一遍。
  "mcp": {
    "servers": {
      "adbmcp": {
        "type": "local",
        "command": ["/home/robin/.local/share/adbmcp-venv/bin/adbmcp"],
        "environment": {
          "ADB_SERIAL": "87e21d30",
          "ADB_PATH": "/usr/bin/adb"
        },
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx", "-y", "@playwright/mcp@latest",
          "--browser", "firefox",
          "--headless",
          "--isolated",
          "--allow-unrestricted-file-access"
        ],
        "disabled": true
      }
    }
  }
}
