// Auto-generated by reflection_tool from rpc_schema.lua — DO NOT EDIT
//
// 引擎外部调试接口的**能力表**：路由身份 / 方法 / 路径 / 超时 + 每端点的请求字段形状。
// 唯一真相源 = `rgl/rpc_schema.lua`（改它然后 `just reflect`）；
// 同一次生成还产 `rgl/generated/rpc_schema.json`（给非 C++ 客户端读的那一份）。
//
// 消费点（少一个消费点 = 这张表在装饰）：
//   · 传输层注册与每端点超时 → rgl/debug_rpc_impl.cppm
//   · 执行层分发（按路径查表 → 穷尽 switch）与 `GET /` 路由回包 → rgl/debug_rpc_exec_impl.cppm
//   · 请求形状校验（含未知字段拒绝）→ rgl/debug_rpc_shape.cppm
//   · 处理函数读字段名 → 本文件的 `rpc_field::<端点>::<字段>` 常量（改 schema 里的字段名 =
//     引用它的处理函数**编译不过**，这就是"访问路径必须消费那个来源"落地的形态）
//   · 手写注册/分发字面量由 tools/checks/rules_rpc.py 拦下（构建期）
//
// ⚠ schema 的 `response` / `shapes` 段（批 3）**不在本文件渲染**：C++ 侧没有它的消费者
//   （回包由处理函数拼装，无运行期校验）；消费方 = 同批生成的 rpc_schema.md（人工参考）
//   与 rpc_schema.json（客户端），对账 = rules_rpc 面 5/6 + 面 1 对 .json 的深度比较。
export module rpc_schema_generated;

import rlstd;

namespace RGL {

/**
 * 路由身份 = 分发 switch 的**穷尽检查载体**。
 *
 * 🔴 新增端点而处理分支没写 = 编译不过（本仓第一方 `-Werror` + `-Wswitch`）。这条性质
 * 依赖分发侧**不写 `default`**：404 是「路径不在表里」，不是「表里某个 id 没处理」——
 * 把 404 塞进 default 会让新端点忘写分支时静默变成「存在但永远 404」。
 */
export enum class RpcRouteId {
    routes,
    state,
    camera,
    param,
    shot,
    shotburst,
    resize,
    pass,
    decorate,
    quit,
};

/** HTTP 方法（只有这两档 ⟹ schema 写第三种方法时生成物直接编不过）。 */
export enum class RpcRouteMethod {
    get,
    post,
};

/**
 * 请求字段的类型档。`any` = **不查类型**（该字段的类型失效仍由处理函数的 `get<T>()` 抛出）。
 *
 * 为什么允许"不查"：schema 只收处理函数**真正在查**的形状（计划 §7「不追求 schema 描述
 * 一切」）。把没查的东西写成查 = 凭空多一条会漂的断言。
 */
export enum class RpcFieldKind {
    any,      ///< 不查类型
    string,   ///< 字符串
    integer,  ///< 整数（浮点不算，同 nlohmann 的 is_number_integer）
    number,   ///< 任意数值
    boolean,  ///< 布尔
    vec3,     ///< 三个数值组成的数组
};

/**
 * 一条请求字段的形状声明（顺序即检查顺序，见 debug_rpc_shape.cppm）。
 *
 * 文案字段是**行为契约**的一部分：客户端按它归因，`tests/test_burst_protocol.cppm` 逐条钉。
 * `error` 覆盖「缺字段 / 类型不符 / 越界」三条（本项目既有文案就是这个形态）；另三条
 * 各给一个覆盖槽，不写 = 落回 `error`。
 */
export struct RpcFieldDef {
    std::string_view name{};
    RpcFieldKind kind = RpcFieldKind::any;
    bool required = false;
    bool nonEmpty = false;
    std::string_view exclusive{};              ///< 互斥的另一字段名（空 = 无）
    std::span<const std::string_view> oneOf{};  ///< 取值白名单（空 = 不查）
    std::optional<double> minValue{};
    std::optional<double> maxValue{};
    std::string_view error{};          ///< 缺字段 / 类型 / 越界
    std::string_view emptyError{};     ///< nonEmpty 失效（空 = 用 error）
    std::string_view oneOfError{};     ///< oneOf 失效（空 = 用 error）
    std::string_view exclusiveError{};  ///< exclusive 失效（空 = 用 error）
};


