Language: Cpp
BasedOnStyle: Google

ColumnLimit: 0
BreakBeforeBraces: Attach
AlignAfterOpenBracket: DontAlign

IndentWidth: 4
TabWidth: 4
UseTab: Always
IndentCaseLabels: false

AllowShortBlocksOnASingleLine: Empty

AlwaysBreakAfterDefinitionReturnType: None

# 全局不排序 include。注意：clang-format 的多文档配置（--- 分隔）只支持按
# Language 区分，不支持按文件后缀（如 .cppm）单独配置，所以无法只对模块文件排序
SortIncludes: false
