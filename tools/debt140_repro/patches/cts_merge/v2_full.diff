+			}
+		}
+	}
+	else
+	{
+		vkd.cmdBindPipeline(*cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, rawPipe.get());
+		if (!heap)
+		{
+			const auto set = *descriptorSet;
+			vkd.cmdBindDescriptorSets(*cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pl.get(), 0u, 1u, &set, 0u, nullptr);
+		}
+	}
+
+	vkd.cmdDrawMeshTasksIndirectEXT(*cmd, *rowBuf.buf, 0ull, rows, 24u);
+
+	if (!eso)
+		endRenderPass(vkd, *cmd);
+	else
+		vkd.cmdEndRendering(*cmd);
+
+	// copy out (helper inserts the layout barrier itself)
+	copyImageToBuffer(vkd, *cmd, color.getImage(), color.getBuffer(), tcu::IVec2(int(extent.width), int(extent.height)));
+	endCommandBuffer(vkd, *cmd);
+
+	// ---- recheck plumbing: a second, separately submitted copy of the color image ----
+	// Used only when a frame fails its check: if a later copy of the image shows the
+	// missing pixels, the first copy raced with rendering; if it shows the same holes,
+	// the workgroups really never wrote.
+	const VkDeviceSize fbBytes = VkDeviceSize(kFbWidth) * kFbHeight * 4u;
+	HostBuf recheckBuf;
+	fillHostBuf(vkd, device, alloc, fbBytes, VK_BUFFER_USAGE_TRANSFER_DST_BIT, recheckBuf);
+	VkCommandBufferAllocateInfo cbai2 = initVulkanStructure();
+	cbai2.commandPool = *cmdPool;
+	cbai2.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+	cbai2.commandBufferCount = 1u;
+	const auto cmd2 = allocateCommandBuffer(vkd, device, &cbai2);
+	beginCommandBuffer(vkd, *cmd2, 0u);
+	copyImageToBuffer(vkd, *cmd2, color.getImage(), *recheckBuf.buf,
+	                  tcu::IVec2(int(extent.width), int(extent.height)), VK_ACCESS_TRANSFER_READ_BIT,
+	                  VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, 1u, VK_IMAGE_ASPECT_COLOR_BIT, VK_IMAGE_ASPECT_COLOR_BIT,
+	                  VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+	endCommandBuffer(vkd, *cmd2);
+
+	// ---- frames: rewrite the row table, resubmit, verify the dispatched set ----
+	std::vector<uint32_t> prevGroups(rows, 0u);
+	std::vector<uint32_t> curGroups(rows, 0u);
+	uint32_t totalGroups = 0u;
+	for (uint32_t frame = 0u; frame < kFrames; ++frame)
+	{
+		uint32_t expectedGroups = 0u;
+		const bool rewrite = m_params.vary || frame == 0u;
+		for (uint32_t r = 0u; r < rows; ++r)
+		{
+			host[r * 6u + 0u] = 1u;                       // gcX = 1 task/row
+			host[r * 6u + 1u] = 1u;
+			host[r * 6u + 2u] = 1u;
+			host[r * 6u + 3u] = r;                        // obj
+			host[r * 6u + 4u] = 0u;                       // cstart
+			if (rewrite)
+				curGroups[r] = 2u + rnd() % 17u;              // groups 2..18 data-driven
+			host[r * 6u + 5u] = curGroups[r];
+			expectedGroups += host[r * 6u + 5u];
+		}
+		totalGroups += expectedGroups;
+
+		if (rewrite)
+		{
+			memcpy(rowBuf.map, host.data(), size_t(kMaxRows) * 24u);
+			flushAlloc(vkd, device, *rowBuf.alloc);
+		}
+
+		submitCommandsAndWait(vkd, device, queue, *cmd);
+
+		// ---- verify ----
+		// Every mesh workgroup must have landed on the slot of its own (row, z), carrying the
+		// row id it drew with and the group count it read. The expected set these come from is
+		// the row table the host just wrote, so the check covers the whole dispatch pipeline:
+		// indirect draw -> task shader row-table read -> per-draw identity -> mesh dispatch -> raster.
+		uint32_t lit = 0u;
+		uint32_t missing = 0u;
+		uint32_t extra = 0u;
+		uint32_t wrongId = 0u;
+		uint32_t wrongGroups = 0u;
+		uint32_t firstBad = 0u;
+		uint32_t badCount = 0u;
+		std::ostringstream bad;
+		auto &outAlloc = color.getBufferAllocation();
+		invalidateAlloc(vkd, device, outAlloc);
+		const auto *px = static_cast<const uint8_t *>(outAlloc.getHostPtr());
+		for (uint32_t y = 0u; y < kFbHeight; ++y)
+		{
+			for (uint32_t x = 0u; x < kFbWidth; ++x)
+			{
+				const uint32_t idx = y * kFbWidth + x;
+				const uint32_t row = idx / kGroupStride;
+				const uint32_t z = idx % kGroupStride;
+				const uint32_t rowGroups = (row < rows) ? host[row * 6u + 5u] : 0u;
+				const bool expected = (row < rows) && (z < rowGroups);
+
+				const uint32_t r = px[idx * 4u + 0u];
+				const uint32_t g = px[idx * 4u + 1u];
+				const uint32_t b = px[idx * 4u + 2u];
+				const uint32_t a = px[idx * 4u + 3u];
+				const bool actual = (a & 0x80u) != 0u;
+				const uint32_t actRow = r | (g << 8u);
+				const uint32_t actGroups = b;
+				const uint32_t actZ = a & 0x7Fu;
+
+				if (actual)
+					++lit;
+				if (actual != expected)
+				{
+					if (missing + extra == 0u)
+						firstBad = idx;
+					if (expected)
+						++missing;
+					else
+						++extra;
+				}
+				if (actual && (actRow != row || actZ != z))
+					++wrongId;
+				if (actual && actGroups != rowGroups)
+					++wrongGroups;
+
+				if ((actual != expected || (actual && (actRow != row || actZ != z || actGroups != rowGroups))) &&
+				    badCount < 40u)
+				{
+					++badCount;
+					bad << " [slot row=" << row << " z=" << z << " expected=" << expected << " got=" << actual
+					    << " drawRow=" << actRow << " groups=" << actGroups << " gotZ=" << actZ
+					    << " hostNow=" << rowGroups
+					    << " hostPrev=" << ((row < rows) ? prevGroups[row] : 0u) << "]";
+				}
+			}
+		}
+
+		if (missing != 0u || extra != 0u || lit != expectedGroups || wrongId != 0u || wrongGroups != 0u)
+		{
+			// recheck: same image, copied again in a separate submission
+			submitCommandsAndWait(vkd, device, queue, *cmd2);
+			invalidateAlloc(vkd, device, *recheckBuf.alloc);
+			const auto *px2 = static_cast<const uint8_t *>(recheckBuf.alloc->getHostPtr());
+			uint32_t stillMissing = 0u, stillExtra = 0u, stillWrongId = 0u, stillWrongGroups = 0u, diffBytes = 0u;
+			for (uint32_t y = 0u; y < kFbHeight; ++y)
+			{
+				for (uint32_t x = 0u; x < kFbWidth; ++x)
+				{
+					const uint32_t idx = y * kFbWidth + x;
+					const uint32_t row = idx / kGroupStride;
+					const uint32_t z = idx % kGroupStride;
+					const uint32_t rowGroups = (row < rows) ? host[row * 6u + 5u] : 0u;
+					const bool expected = (row < rows) && (z < rowGroups);
+					if (px[idx * 4u + 0u] != px2[idx * 4u + 0u] || px[idx * 4u + 1u] != px2[idx * 4u + 1u] ||
+					    px[idx * 4u + 2u] != px2[idx * 4u + 2u] || px[idx * 4u + 3u] != px2[idx * 4u + 3u])
+						++diffBytes;
+					const uint32_t a = px2[idx * 4u + 3u];
+					const bool actual = (a & 0x80u) != 0u;
+					const uint32_t actRow = uint32_t(px2[idx * 4u + 0u]) | (uint32_t(px2[idx * 4u + 1u]) << 8u);
+					const uint32_t actGroups = px2[idx * 4u + 2u];
+					const uint32_t actZ = a & 0x7Fu;
+					if (actual != expected)
+						(expected ? stillMissing : stillExtra)++;
+					if (actual && (actRow != row || actZ != z))
+						++stillWrongId;
+					if (actual && actGroups != rowGroups)
+						++stillWrongGroups;
+				}
+			}
+
+			std::ostringstream msg;
+			msg << "frame " << frame << ": dispatched set mismatch (rows=" << rows << ", expected groups="
+			    << expectedGroups << ", lit=" << lit << ", missing=" << missing << ", extra=" << extra
+			    << ", wrongRowIdOrZ=" << wrongId << ", wrongGroups=" << wrongGroups << ", first bad slot=" << firstBad
+			    << ") recheck(diffPixels=" << diffBytes << " missing=" << stillMissing << " extra=" << stillExtra
+			    << " wrongRowIdOrZ=" << stillWrongId << " wrongGroups=" << stillWrongGroups << ")" << bad.str();
+			return tcu::TestStatus::fail(msg.str());
+		}
+
+		prevGroups = curGroups;
+	}
+
+	std::ostringstream ok;
+	ok << "ok rows=" << rows << " frames=" << kFrames << " groups=" << totalGroups;
+	return tcu::TestStatus::pass(ok.str());
+}
+
+} // namespace
+
+tcu::TestCaseGroup *createMeshShaderMdiMergeTestsEXT(tcu::TestContext &testCtx)
+{
+	de::MovePtr<tcu::TestCaseGroup> group(new tcu::TestCaseGroup(testCtx, "mdimerge"));
+	const uint32_t doses[] = {6u, 150u, 900u, 1800u};
+	for (uint32_t h = 0u; h < 2u; ++h)
+		for (uint32_t e = 0u; e < 2u; ++e)
+			for (uint32_t v = 0u; v < 2u; ++v)
+				for (const uint32_t d : doses)
+				{
+					MergeParams p;
+					p.eso = (e != 0u);
+					p.heap = (h != 0u);
+					p.vary = (v != 0u);
+					p.rows = d;
+					p.seed = 1u + d;
+					group->addChild(new MergeCase(testCtx, caseName(p), p));
+				}
+	return group.release();
+}
