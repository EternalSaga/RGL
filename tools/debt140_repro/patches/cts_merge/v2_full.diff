+				vkd.cmdSetDepthBiasEnable(*cmd, VK_FALSE);
+				vkd.cmdSetBlendConstants(*cmd, bc);
+				vkd.cmdSetDepthBounds(*cmd, 0.0f, 1.0f);
+				vkd.cmdSetStencilCompareMask(*cmd, VK_STENCIL_FACE_FRONT_AND_BACK, 0xFFFFFFFFu);
+				vkd.cmdSetStencilWriteMask(*cmd, VK_STENCIL_FACE_FRONT_AND_BACK, 0xFFFFFFFFu);
+				vkd.cmdSetStencilReference(*cmd, VK_STENCIL_FACE_FRONT_AND_BACK, 0u);
+				vkd.cmdSetCullMode(*cmd, VK_CULL_MODE_NONE);
+				vkd.cmdSetFrontFace(*cmd, VK_FRONT_FACE_COUNTER_CLOCKWISE);
+				vkd.cmdSetPrimitiveTopology(*cmd, VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST);
