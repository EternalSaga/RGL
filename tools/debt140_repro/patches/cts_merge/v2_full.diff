+				vkd.cmdSetColorWriteMaskEXT(*cmd, 0u, 1u, &wmask);
+				vkd.cmdSetAlphaToCoverageEnableEXT(*cmd, VK_FALSE);
+				vkd.cmdSetAlphaToOneEnableEXT(*cmd, VK_FALSE);
+				vkd.cmdSetVertexInputEXT(*cmd, 0u, nullptr, 0u, nullptr);
+				vkd.cmdSetPolygonModeEXT(*cmd, VK_POLYGON_MODE_FILL);
