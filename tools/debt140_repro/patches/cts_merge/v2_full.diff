+				vkd.cmdSetRasterizerDiscardEnable(*cmd, VK_FALSE);
+				vkd.cmdSetDepthTestEnable(*cmd, VK_FALSE);
+				vkd.cmdSetDepthWriteEnable(*cmd, VK_FALSE);
+				vkd.cmdSetDepthCompareOp(*cmd, VK_COMPARE_OP_LESS);
+				vkd.cmdSetDepthBoundsTestEnable(*cmd, VK_FALSE);
+				vkd.cmdSetStencilTestEnable(*cmd, VK_FALSE);
+				vkd.cmdSetStencilOp(*cmd, VK_STENCIL_FACE_FRONT_BIT, VK_STENCIL_OP_KEEP, VK_STENCIL_OP_KEEP,
