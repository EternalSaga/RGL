+				vkd.cmdSetSampleMaskEXT(*cmd, samples, &sampleMask);
+				vkd.cmdSetDepthClampEnableEXT(*cmd, VK_FALSE);
+			}
+			for (const auto ds : dynStates)
+			{
+				switch (ds)
+				{
+				case VK_DYNAMIC_STATE_VIEWPORT: {
+					const VkViewport v = makeViewport(extent);
