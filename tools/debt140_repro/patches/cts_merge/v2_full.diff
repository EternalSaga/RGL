+		VkClearValue cv = {};
+		cv.color = {{cc[0], cc[1], cc[2], cc[3]}};
+		const VkRenderingAttachmentInfo colorAtt = {
+			VK_STRUCTURE_TYPE_RENDERING_ATTACHMENT_INFO, nullptr, color.getImageView(),
+			VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_RESOLVE_MODE_NONE, VK_NULL_HANDLE, VK_IMAGE_LAYOUT_UNDEFINED,
+			VK_ATTACHMENT_LOAD_OP_CLEAR, VK_ATTACHMENT_STORE_OP_STORE, cv};
+		const VkRenderingInfo ri = {VK_STRUCTURE_TYPE_RENDERING_INFO, nullptr, 0u,
