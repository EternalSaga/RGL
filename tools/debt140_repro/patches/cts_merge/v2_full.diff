+/*
+ ** Merged MDI test (RGL debt-140 forensics §23): mesh api-shape MDI × {classic, ESO} ×
+ ** {descriptor-set, descriptor-heap} × dose × {per-frame rewrite, frozen}. NOT upstream —
+ ** local probe for the shader-object + descriptor-heap × mesh-MDI × dose interaction.
+ **
+ ** What the probe measures, and why the verdict is exact:
+ **  - The task shader reads the per-row mesh-group count out of the row table (the one
+ **    descriptor the arm under test has to deliver) and re-emits (row id, count read) as
+ **    task->mesh payload.
+ **  - The mesh shader draws exactly one pixel-sized triangle per mesh workgroup, at a
+ **    position derived from (rowId, workgroupId.z). (rowId, z) -> pixel is injective, and
+ **    the fragment shader writes the payload back into the pixel, so every drawn pixel
+ **    carries the row id the draw reported and the group count it read.
+ **  - The host wrote the row table, so it knows the expected set pixel by pixel. The check
+ **    is a full comparison, not a "something was drawn" smoke test: under-dispatch,
+ **    over-dispatch, a group on the wrong pixel, a wrong row id and a wrong group count
+ **    each fail with the offending slots printed.
+ **  - Failing frames are re-checked with a second, separately submitted copy of the color
+ **    image, which separates "the first copy raced with rendering" from "the workgroups
+ **    really never wrote".
+ **  - Arms: classic pipeline / ESO shader objects x descriptor set / descriptor heap, all
+ **    four running the same data and the same expected set, so they are comparable by
+ **    construction.
+ **  - vary = row table rewritten and resubmitted every frame (engine shape: persistent
+ **    mapping, per-frame rewrite); fixed = written once (control for host-write races).
+ **
+ ** Observed on RADV 26.2.4 (Radeon 8060S / gfx1151): rare frames lose a handful of mesh
+ ** workgroups, and the payload read by the mesh workgroups then carries a (rowId, count)
+ ** pair that does not belong to that draw — including ids beyond drawCount that can only
+ ** come from a previous test case's row table. See RGL doc §23.
+ */
+
+#include "vktMeshShaderMdiMergeTestsEXT.hpp"
+#include "vktMeshShaderUtil.hpp"
+#include "vktTestCaseUtil.hpp"
+
+#include "vkBarrierUtil.hpp"
+#include "vkBuilderUtil.hpp"
+#include "vkBufferWithMemory.hpp"
+#include "vkCmdUtil.hpp"
+#include "vkDefs.hpp"
+#include "vkImageUtil.hpp"
+#include "vkImageWithMemory.hpp"
+#include "vkMemUtil.hpp"
+#include "vkObjUtil.hpp"
+#include "vkPipelineConstructionUtil.hpp"
+#include "vkPrograms.hpp"
+#include "vkQueryUtil.hpp"
+#include "vkRefUtil.hpp"
+#include "vkShaderObjectUtil.hpp"
+#include "vkTypeUtil.hpp"
+
+#include <cstring>
+#include <sstream>
+#include <vector>
+
+namespace vkt
+{
+namespace MeshShader
+{
+namespace
+{
+
+using namespace vk;
+
+// Framebuffer of the probe: one pixel per (row, z) slot.
+const uint32_t kFbWidth  = 512u;
+const uint32_t kFbHeight = 512u;
+// Slots reserved per row. Must match MESH_GLSL. A row dispatches at most 18 groups,
+// the slack lets over-dispatch land on fresh pixels instead of on the next row.
+const uint32_t kGroupStride = 64u;
+// Row table is always allocated for this many rows so a bogus gl_DrawID can never
+// make the task shader read out of bounds (the GLSL mirror of this constant is the
+// "% 1800u" in TASK_GLSL).
+const uint32_t kMaxRows = 1800u;
+// Frames per case: row table is rewritten and resubmitted every frame.
+// 400 frames mirrors the engine arm (RGL §21: hang rate scales with groups per
+// dispatch, engine arm = 400 frames x 1530 rows).
+const uint32_t kFrames = 400u;
+
+struct MergeParams
+{
+	bool			eso;
+	bool			heap;
+	bool			vary;   // rewrite the row table every frame (engine shape) vs write once (control)
+	uint32_t		rows;
+	uint32_t		seed;
+};
+
+// Σ(mesh groups) ≈ rows × mean(2..18) ≈ rows × 10
+static std::string caseName(const MergeParams &p)
+{
+	std::ostringstream nm;
+	nm << (p.heap ? (p.eso ? "soheap" : "heap") : (p.eso ? "so" : "classic")) << ".";
+	nm << (p.vary ? "vary" : "fixed") << ".";
+	if (p.rows <= 8u) nm << "s64";
+	else if (p.rows <= 200u) nm << "s1530";
+	else if (p.rows <= 1000u) nm << "s9200";
+	else nm << "s18400";
+	return nm.str();
+}
+
+const char *TASK_GLSL =
+	"#version 460\n"
+	"#extension GL_EXT_mesh_shader : require\n"
+	"layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;\n"
+	"layout(std430, set = 0, binding = 0) buffer RowTable { uint t[]; } rows;\n"
+	"struct MeshPayload { uint rowId; uint groups; };\n"
+	"taskPayloadSharedEXT MeshPayload payload;\n"
+	"void main() {\n"
+	"    uint rid = gl_DrawID;\n"
+	"    uint g = rows.t[(rid % 1800u) * 6u + 5u];\n"
+	"    payload.rowId = rid;\n"
+	"    payload.groups = g;\n"
+	"    EmitMeshTasksEXT(1u, 1u, g);\n"
+	"}\n";
+
+const char *MESH_GLSL =
+	"#version 460\n"
+	"#extension GL_EXT_mesh_shader : require\n"
+	"layout(local_size_x = 3, local_size_y = 1, local_size_z = 1) in;\n"
+	"layout(triangles) out;\n"
+	"layout(max_vertices = 3, max_primitives = 1) out;\n"
+	"struct MeshPayload { uint rowId; uint groups; };\n"
+	"taskPayloadSharedEXT MeshPayload payload;\n"
+	"layout(location = 0) out flat uvec3 slotInfo[3];\n"
+	"void main() {\n"
+	"    SetMeshOutputsEXT(3u, 1u);\n"
+	"    uint v = gl_LocalInvocationID.x;\n"
+	"    uint idx = payload.rowId * 64u + gl_WorkGroupID.z;\n"
+	"    uint px = idx % 512u;\n"
+	"    uint py = idx / 512u;\n"
+	"    slotInfo[v] = uvec3(payload.rowId, payload.groups, gl_WorkGroupID.z);\n"
+	"    vec2 corner[3] = vec2[3](vec2(0.06, 0.06), vec2(0.94, 0.06), vec2(0.5, 0.94));\n"
+	"    vec2 p = vec2(float(px), float(py)) + corner[v];\n"
+	"    vec2 ndc = (p / 512.0) * 2.0 - 1.0;\n"
+	"    gl_MeshVerticesEXT[v].gl_Position = vec4(ndc.x, ndc.y, 0.0, 1.0);\n"
+	"    if (v == 0u)\n"
+	"        gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);\n"
+	"}\n";
+
+// Pixel payload: R|G = rowId the draw reported, B = group count it read from the row
+// table, A = 0x80 | z (nonzero, so "written" is distinguishable from the black clear).
+const char *FRAG_GLSL =
+	"#version 450\n"
+	"layout(location = 0) in flat uvec3 slotInfo;\n"
+	"layout(location = 0) out vec4 color;\n"
+	"void main() {\n"
+	"    color = vec4(float(slotInfo.x & 0xFFu) / 255.0,\n"
+	"                 float((slotInfo.x >> 8u) & 0xFFu) / 255.0,\n"
+	"                 float(slotInfo.y & 0xFFu) / 255.0,\n"
+	"                 float(128u | (slotInfo.z & 0x7Fu)) / 255.0);\n"
+	"}\n";
+
+// Host-mapped buffer with device address.
+struct HostBuf
+{
+	Move<VkBuffer>			buf;
+	de::MovePtr<Allocation>	alloc;
+	void				   *map = nullptr;
+	VkDeviceAddress			addr = 0;
+};
+
+void fillHostBuf(const DeviceInterface &vkd, VkDevice device, Allocator &alloc, VkDeviceSize size,
+                 VkBufferUsageFlags usage, HostBuf &hb, bool wantAddr = false,
+                 VkBufferUsageFlags2KHR usage2 = 0)
+{
+	VkBufferUsageFlags2CreateInfoKHR u2 = initVulkanStructure();
+	VkBufferCreateInfo bi = initVulkanStructure();
+	bi.size = size;
+	bi.usage = usage;
+	if (usage2 != 0)
+	{
+		u2.usage = usage2;
+		bi.pNext = &u2;
+		bi.usage = VkBufferUsageFlags(usage2 & 0xFFFFFFFFu);
+	}
+	bi.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+	hb.buf = createBuffer(vkd, device, &bi);
+	VkMemoryRequirements memReq = {};
+	vkd.getBufferMemoryRequirements(device, *hb.buf, &memReq);
+	hb.alloc = wantAddr ? alloc.allocate(memReq, HostIntent::RW, VK_MEMORY_ALLOCATE_DEVICE_ADDRESS_BIT)
+	                       : alloc.allocate(memReq, MemoryRequirement::HostVisible, 1);
+	VK_CHECK(vkd.bindBufferMemory(device, *hb.buf, hb.alloc->getMemory(), 0));
+	hb.map = hb.alloc->getHostPtr();
+	if (wantAddr)
+	{
+		VkBufferDeviceAddressInfo dai = initVulkanStructure();
+		dai.buffer = *hb.buf;
+		hb.addr = vkd.getBufferDeviceAddress(device, &dai);
+	}
+}
+
+class MergeCase : public vkt::TestCase
+{
+public:
+	MergeCase(tcu::TestContext &testCtx, const std::string &name, const MergeParams &params)
+		: vkt::TestCase(testCtx, name)
+		, m_params(params)
+	{
+	}
+	virtual ~MergeCase() = default;
+
+	void initPrograms(SourceCollections &programCollection) const override
+	{
+		const auto buildOptions = getMinMeshEXTBuildOptions(programCollection.usedVulkanVersion);
+		programCollection.glslSources.add("task") << glu::TaskSource(TASK_GLSL) << buildOptions;
+		programCollection.glslSources.add("mesh") << glu::MeshSource(MESH_GLSL) << buildOptions;
+		programCollection.glslSources.add("frag") << glu::FragmentSource(FRAG_GLSL) << buildOptions;
+	}
+
+	void checkSupport(Context &context) const override
+	{
+		checkTaskMeshShaderSupportEXT(context, true, true);
+		context.requireDeviceCoreFeature(DEVICE_CORE_FEATURE_MULTI_DRAW_INDIRECT);
+		// the task shader reads gl_DrawID to find its row
+		if (context.getShaderDrawParametersFeatures().shaderDrawParameters == VK_FALSE)
+			TCU_THROW(NotSupportedError, "shaderDrawParameters feature not supported by the device");
+		if (m_params.eso)
+			context.requireDeviceFunctionality("VK_EXT_shader_object");
+		if (m_params.heap)
+		{
+			context.requireDeviceFunctionality("VK_EXT_descriptor_heap");
+			context.requireDeviceFunctionality("VK_KHR_buffer_device_address");
+		}
+	}
+
+	vkt::TestInstance *createInstance(Context &context) const override;
+
+private:
+	MergeParams m_params;
+};
+
+class MergeInstance : public vkt::TestInstance
+{
+public:
+	MergeInstance(Context &context, const MergeParams &params)
+		: vkt::TestInstance(context)
+		, m_params(params)
+	{
+	}
+	virtual ~MergeInstance() = default;
+
+	tcu::TestStatus iterate(void) override;
+
+private:
+	MergeParams m_params;
+};
+
+vkt::TestInstance *MergeCase::createInstance(Context &context) const
+{
+	return new MergeInstance(context, m_params);
+}
+
+tcu::TestStatus MergeInstance::iterate(void)
+{
+	const auto &vkd = m_context.getDeviceInterface();
+	const auto &device = m_context.getDevice();
+	const auto &vki = m_context.getInstanceInterface();
+	const auto queueIndex = m_context.getUniversalQueueFamilyIndex();
+	const auto queue = m_context.getUniversalQueue();
+	auto &alloc = m_context.getDefaultAllocator();
+	const auto &binaries = m_context.getBinaryCollection();
+
+	const uint32_t rows = m_params.rows;
+	const bool eso = m_params.eso;
+	const bool heap = m_params.heap;
+	const VkExtent3D extent = makeExtent3D(kFbWidth, kFbHeight, 1u);
+	const auto fbFormat = VK_FORMAT_R8G8B8A8_UNORM;
+
+	// ---- row table: engine layout {gcX,1,1, obj,cstart,groups} stride 24 ----
+	std::vector<uint32_t> host(kMaxRows * 6u, 0u); // tail rows stay zero => out-of-range draw ids dispatch nothing
+	uint64_t s = 0x5DEECE66Dull ^ (uint64_t(m_params.seed) * 0x9E3779B97F4A7C15ull);
+	auto rnd = [&]() {
+		s = s * 6364136223846793005ull + 1442695040888963407ull;
+		return uint32_t((s >> 33u) & 0xFFFFFu);
+	};
+
+	auto rowUsage = (VkBufferUsageFlags)(VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT);
+	if (heap)
+		rowUsage = (VkBufferUsageFlags)(rowUsage | VK_BUFFER_USAGE_SHADER_DEVICE_ADDRESS_BIT);
+	HostBuf rowBuf;
+	fillHostBuf(vkd, device, alloc, VkDeviceSize(kMaxRows) * 24u, rowUsage, rowBuf, heap);
+
+	// ---- color target ----
+	const auto colorSRR = makeImageSubresourceRange(VK_IMAGE_ASPECT_COLOR_BIT, 0u, 1u, 0u, 1u);
+	ImageWithBuffer color(vkd, device, alloc, extent, fbFormat,
+	                      (VkImageUsageFlags)(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT),
+	                      VK_IMAGE_TYPE_2D, colorSRR, 1u);
+
+	// ---- heap plumbing ----
+	VkDeviceSize resourceStride = 0;
+	VkDeviceSize heapSize = 0;
+	HostBuf heapBuf;
+	HostBuf pushBuf;
+	VkPhysicalDeviceDescriptorHeapPropertiesEXT heapProps = initVulkanStructure();
+	if (heap)
+	{
+		heapProps = m_context.getDescriptorHeapPropertiesEXT();
+		resourceStride = heapProps.bufferDescriptorSize;
+		const VkDeviceSize heapUser = resourceStride * 4u;
+		heapSize = heapUser + heapProps.minResourceHeapReservedRange;
+		fillHostBuf(vkd, device, alloc, heapSize, VK_BUFFER_USAGE_FLAG_BITS_MAX_ENUM, heapBuf, true,
+		            (VkBufferUsageFlags2KHR)(VK_BUFFER_USAGE_2_DESCRIPTOR_HEAP_BIT_EXT |
+		                                     VK_BUFFER_USAGE_2_SHADER_DEVICE_ADDRESS_BIT));
+		// descriptor slot 0 -> row table
+		VkResourceDescriptorInfoEXT rdi = initVulkanStructure();
+		rdi.type = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+		VkDeviceAddressRangeEXT bar = {};
+		bar.address = rowBuf.addr;
+		bar.size = VkDeviceSize(kMaxRows) * 24u;
+		rdi.data.pAddressRange = &bar;
+		VkHostAddressRangeEXT dst = {};
+		dst.address = heapBuf.map;
+		dst.size = resourceStride;
+		VK_CHECK(vkd.writeResourceDescriptorsEXT(device, 1u, &rdi, &dst));
+		// push data: heap index 0 (uint32 at push offset 0)
+		fillHostBuf(vkd, device, alloc, 8u, VK_BUFFER_USAGE_TRANSFER_SRC_BIT, pushBuf);
+		memset(pushBuf.map, 0, 8u);
+	}
+
+	// ---- set layout (+ mapping for heap) ----
+	const auto dsl = DescriptorSetLayoutBuilder()
+	                     .addSingleBinding(VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, VK_SHADER_STAGE_TASK_BIT_EXT)
+	                     .build(vkd, device);
+
+	VkDescriptorSetAndBindingMappingEXT mapping = initVulkanStructure();
+	mapping.descriptorSet = 0u;
+	mapping.firstBinding = 0u;
+	mapping.bindingCount = 1u;
+	mapping.resourceMask = VK_SPIRV_RESOURCE_TYPE_ALL_EXT;
+	if (heap)
+	{
+		mapping.source = VK_DESCRIPTOR_MAPPING_SOURCE_HEAP_WITH_PUSH_INDEX_EXT;
+		mapping.sourceData.pushIndex.heapOffset = 0u;
+		mapping.sourceData.pushIndex.pushOffset = 0u;
+		mapping.sourceData.pushIndex.heapIndexStride = uint32_t(resourceStride);
+		mapping.sourceData.pushIndex.heapArrayStride = uint32_t(resourceStride);
+	}
+	VkShaderDescriptorSetAndBindingMappingInfoEXT mappingInfo = initVulkanStructure();
+	mappingInfo.mappingCount = 1u;
+	mappingInfo.pMappings = &mapping;
+
+	const VkDescriptorSetLayout dslRaw = dsl.get();
+	const auto pl = makePipelineLayout(vkd, device, dslRaw);
+
+	// classic-set descriptor (bound only in non-heap arms; pool only exists there)
+	Move<VkDescriptorPool> descriptorPool;
+	Move<VkDescriptorSet> descriptorSet;
+	if (!heap)
+	{
+		DescriptorPoolBuilder poolBuilder;
+		poolBuilder.addType(VK_DESCRIPTOR_TYPE_STORAGE_BUFFER);
+		descriptorPool = poolBuilder.build(vkd, device, VK_DESCRIPTOR_POOL_CREATE_FREE_DESCRIPTOR_SET_BIT, 1u);
+		descriptorSet = makeDescriptorSet(vkd, device, *descriptorPool, dsl.get());
+		const VkDescriptorBufferInfo rowBufInfo =
+		    makeDescriptorBufferInfo(*rowBuf.buf, 0ull, VkDeviceSize(kMaxRows) * 24u);
+		DescriptorSetUpdateBuilder updateBuilder;
+		updateBuilder.writeSingle(*descriptorSet, DescriptorSetUpdateBuilder::Location::binding(0u),
+		                          VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, &rowBufInfo);
+		updateBuilder.update(vkd, device);
+	}
+
+	const std::vector<VkViewport> viewports(1u, makeViewport(extent));
+	const std::vector<VkRect2D> scissors(1u, makeRect2D(extent));
+
+	// classic render pass + framebuffer (used by non-ESO arms; ESO uses dynamic rendering)
+	const auto rp = makeRenderPass(vkd, device, fbFormat);
+	const auto fb = makeFramebuffer(vkd, device, rp.get(), color.getImageView(), extent.width, extent.height);
+
+	// ---- pipeline (classic) or shader objects (ESO) ----
+	const auto ctype = eso ? PIPELINE_CONSTRUCTION_TYPE_SHADER_OBJECT_UNLINKED_SPIRV
+	                       : PIPELINE_CONSTRUCTION_TYPE_MONOLITHIC;
+	std::unique_ptr<GraphicsPipelineWrapper> pipeWrap;
+	PipelineLayoutWrapper layoutWrap;
+	Move<VkPipeline> rawPipe;
+	std::vector<Move<VkShaderEXT>> shaders; // ESO+heap manual path
+	std::vector<VkDynamicState> dynStates;
+
+	if (eso)
+		dynStates = getShaderObjectDynamicStatesFromExtensions(m_context.getDeviceExtensions());
+
+	VkPipelineShaderStageCreateInfo stages[3] = {initVulkanStructure(), initVulkanStructure(), initVulkanStructure()};
+	const auto taskMod = createShaderModule(vkd, device, binaries.get("task"));
+	const auto meshMod = createShaderModule(vkd, device, binaries.get("mesh"));
+	const auto fragMod = createShaderModule(vkd, device, binaries.get("frag"));
+	stages[0].stage = VK_SHADER_STAGE_TASK_BIT_EXT;
+	stages[0].module = *taskMod;
+	stages[0].pName = "main";
+	stages[1].stage = VK_SHADER_STAGE_MESH_BIT_EXT;
+	stages[1].module = *meshMod;
+	stages[1].pName = "main";
+	stages[2].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+	stages[2].module = *fragMod;
+	stages[2].pName = "main";
+	if (heap)
+	{
+		stages[0].pNext = &mappingInfo; // task stage resolves binding 0 from heap w/ push index
+	}
+
+	if (!eso)
+	{
+		VkPipelineVertexInputStateCreateInfo vinCi = initVulkanStructure();
+		VkPipelineInputAssemblyStateCreateInfo iaCi = initVulkanStructure();
+		iaCi.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+		VkPipelineRasterizationStateCreateInfo rs = initVulkanStructure();
+		rs.lineWidth = 1.0f;
+		VkPipelineMultisampleStateCreateInfo ms = initVulkanStructure();
+		ms.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+		VkPipelineDepthStencilStateCreateInfo ds = initVulkanStructure();
+		VkPipelineColorBlendAttachmentState cba = {};
+		cba.colorWriteMask = 0xF;
+		VkPipelineColorBlendStateCreateInfo cb = initVulkanStructure();
+		cb.attachmentCount = 1u;
+		cb.pAttachments = &cba;
+		VkPipelineDynamicStateCreateInfo dyn = initVulkanStructure();
+		VkPipelineCreateFlags2CreateInfoKHR flags2 = initVulkanStructure();
+		if (heap)
+			flags2.flags = VK_PIPELINE_CREATE_2_DESCRIPTOR_HEAP_BIT_EXT;
+		const std::vector<VkPipelineShaderStageCreateInfo> stageVec(stages, stages + 3);
+		rawPipe = makeGraphicsPipeline(vkd, device, VK_NULL_HANDLE, heap ? (VkPipelineLayout)VK_NULL_HANDLE : pl.get(),
+		                               0u, stageVec, rp.get(), viewports, scissors, 0u, &rs, &ms, &ds, &cb, &dyn,
+		                               heap ? (const void *)&flags2 : nullptr, &vinCi, &iaCi);
+	}
+	else if (!heap)
+	{
+		pipeWrap = std::make_unique<GraphicsPipelineWrapper>(vki, vkd, m_context.getPhysicalDevice(), device,
+		                                                     m_context.getDeviceExtensions(), ctype);
+		ShaderWrapper taskSh(vkd, device, binaries.get("task"), VK_SHADER_STAGE_TASK_BIT_EXT);
+		ShaderWrapper meshSh(vkd, device, binaries.get("mesh"), VK_SHADER_STAGE_MESH_BIT_EXT);
+		ShaderWrapper fragSh(vkd, device, binaries.get("frag"), VK_SHADER_STAGE_FRAGMENT_BIT);
+		VkDescriptorSetLayout dslArr[1] = {dsl.get()};
+		layoutWrap = PipelineLayoutWrapper(ctype, vkd, device, 1u, dslArr);
+		VkPipelineColorBlendAttachmentState cbaEso = {};
+		cbaEso.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT |
+		                        VK_COLOR_COMPONENT_A_BIT;
+		VkPipelineColorBlendStateCreateInfo cbEso = initVulkanStructure();
+		cbEso.attachmentCount = 1u;
+		cbEso.pAttachments = &cbaEso;
