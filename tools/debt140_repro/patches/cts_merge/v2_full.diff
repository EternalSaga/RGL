+					break;
+				}
+				case VK_DYNAMIC_STATE_LINE_WIDTH: vkd.cmdSetLineWidth(*cmd, 1.0f); break;
+				case VK_DYNAMIC_STATE_DEPTH_BIAS: break; // legacy alias; DEPTH_BIAS_ENABLE set false in base block
+				case VK_DYNAMIC_STATE_BLEND_CONSTANTS: {
+					const float bc[4] = {0, 0, 0, 0};
+					vkd.cmdSetBlendConstants(*cmd, bc);
+					break;
+				}
+				case VK_DYNAMIC_STATE_DEPTH_BOUNDS: vkd.cmdSetDepthBounds(*cmd, 0.0f, 1.0f); break;
+				case VK_DYNAMIC_STATE_STENCIL_COMPARE_MASK: vkd.cmdSetStencilCompareMask(*cmd, VK_STENCIL_FACE_FRONT_AND_BACK, 0xFFFFFFFFu); break;
+				case VK_DYNAMIC_STATE_STENCIL_WRITE_MASK: vkd.cmdSetStencilWriteMask(*cmd, VK_STENCIL_FACE_FRONT_AND_BACK, 0xFFFFFFFFu); break;
+				case VK_DYNAMIC_STATE_STENCIL_REFERENCE: vkd.cmdSetStencilReference(*cmd, VK_STENCIL_FACE_FRONT_AND_BACK, 0u); break;
+				case VK_DYNAMIC_STATE_CULL_MODE: vkd.cmdSetCullMode(*cmd, VK_CULL_MODE_NONE); break;
+				case VK_DYNAMIC_STATE_FRONT_FACE: vkd.cmdSetFrontFace(*cmd, VK_FRONT_FACE_COUNTER_CLOCKWISE); break;
+				case VK_DYNAMIC_STATE_PRIMITIVE_TOPOLOGY: vkd.cmdSetPrimitiveTopology(*cmd, VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST); break;
+				case VK_DYNAMIC_STATE_PRIMITIVE_RESTART_ENABLE: vkd.cmdSetPrimitiveRestartEnable(*cmd, VK_FALSE); break;
+				case VK_DYNAMIC_STATE_RASTERIZER_DISCARD_ENABLE: vkd.cmdSetRasterizerDiscardEnable(*cmd, VK_FALSE); break;
+				case VK_DYNAMIC_STATE_DEPTH_TEST_ENABLE: vkd.cmdSetDepthTestEnable(*cmd, VK_FALSE); break;
+				case VK_DYNAMIC_STATE_DEPTH_WRITE_ENABLE: vkd.cmdSetDepthWriteEnable(*cmd, VK_FALSE); break;
+				case VK_DYNAMIC_STATE_DEPTH_COMPARE_OP: vkd.cmdSetDepthCompareOp(*cmd, VK_COMPARE_OP_LESS); break;
+				case VK_DYNAMIC_STATE_DEPTH_BOUNDS_TEST_ENABLE: vkd.cmdSetDepthBoundsTestEnable(*cmd, VK_FALSE); break;
