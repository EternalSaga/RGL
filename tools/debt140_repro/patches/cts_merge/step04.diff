+	"void main() {\n"
+	"    SetMeshOutputsEXT(3u, 1u);\n"
+	"    if (gl_LocalInvocationID.x == 0u) ssum = 0u;\n"
+	"    barrier();\n"
+	"    uint base = gl_WorkGroupID.x * 256u + gl_LocalInvocationID.x * 8u;\n"
+	"    uint mine = 0u;\n"
+	"    for (int j = 0; j < 8; ++j) mine += tbl.t[(base + uint(j)) & 1048575u];\n"
+	"    atomicAdd(ssum, mine);\n"
+	"    barrier();\n"
+	"    uint sum = ssum;\n"
+	"    uint slot = 262100u + (sum % 40u);\n"
+	"    uint px = slot % 512u;\n"
+	"    uint py = slot / 512u;\n"
+	"    uint v = gl_LocalInvocationID.x;\n"
+	"    vec2 lp[3] = vec2[3](vec2(0.1, 0.1), vec2(0.9, 0.1), vec2(0.5, 0.9));\n"
+	"    vec2 p = (vec2(float(px), float(py)) + lp[v] * 0.8) / vec2(512.0, 512.0);\n"
+	"    gl_MeshVerticesEXT[v].gl_Position = vec4(p.x * 2.0 - 1.0, 1.0 - p.y * 2.0, 0.0, 1.0);\n"
+	"    if (v == 0u) gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0u, 1u, 2u);\n"
+	"    slotInfo[v] = uvec3(sum & 255u, (sum >> 8) & 255u, 64u);\n"
+	"}\n";
