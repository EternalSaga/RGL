+// step05 (engine shadow shape): D32 depth-only atlas. Each mesh workgroup lands on the unique
+// pixel of (rowId, z) INSIDE its cascade tile (256x256, 3 tiles side by side). The encoded group
+// id rides on gl_Position.z (Vulkan NDC z in [0,1], w=1 -> window depth = z; all three vertices
+// share z so interpolation is constant) and the fragment is an EMPTY SHELL - exactly the engine
+// shadow.frag shape. enc = rowId<<10 | groups<<5 | z (21 bits; depth=(enc+0.5)/2^22 is exactly
+// representable in float32). Triangles use the color arm's proven full-pixel corners.
+const char *MESH_D32_GLSL =
+	"#version 460\n"
+	"#extension GL_EXT_mesh_shader : require\n"
+	"layout(local_size_x = 3, local_size_y = 1, local_size_z = 1) in;\n"
+	"layout(triangles) out;\n"
+	"layout(max_vertices = 3, max_primitives = 1) out;\n"
+	"struct MeshPayload { uint rowId; uint groups; uint obj; };\n"
+	"taskPayloadSharedEXT MeshPayload payload;\n"
+	"void main() {\n"
+	"    SetMeshOutputsEXT(3u, 1u);\n"
+	"    uint v = gl_LocalInvocationID.x;\n"
+	"    uint idx = payload.rowId * 64u + gl_WorkGroupID.x;\n"
+	"    uint px = (payload.obj * 256u) + idx % 256u;\n"
+	"    uint py = idx / 256u;\n"
+	"    vec2 corner[3] = vec2[3](vec2(0.0, 0.0), vec2(16.0, 0.0), vec2(0.0, 16.0));\n"
+	"    vec2 q = vec2(float(px) + corner[v].x, float(py) + corner[v].y - 14.0);\n" // step05 finding: DB raster y == CB y + 14 on this driver
+	"    vec2 p = vec2(q.x / 768.0, q.y / 256.0);\n"
+	"    p.x = p.x * 2.0 - 1.0;\n"
+	"    p.y = p.y * 2.0 - 1.0;\n" // step05 finding: DB raster uses UNFLIPPED y
+	"    uint enc = (payload.rowId << 10u) | (payload.groups << 5u) | gl_WorkGroupID.x;\n"
+	"    float z = (float(enc) + 0.5) / 4194304.0;\n"
+	"    gl_MeshVerticesEXT[v].gl_Position = vec4(p.x, p.y, z, 1.0);\n"
+	"    if (v == 0u)\n"
+	"        gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0u, 1u, 2u);\n"
+	"}\n";
