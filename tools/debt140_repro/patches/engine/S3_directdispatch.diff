diff --git a/rgl/shaders/shadow_meshlet.task.slang b/rgl/shaders/shadow_meshlet.task.slang
index 5dfee19..fbb22ed 100644
--- a/rgl/shaders/shadow_meshlet.task.slang
+++ b/rgl/shaders/shadow_meshlet.task.slang
@@ -104,7 +104,14 @@ ByteAddressBuffer mdiShadowArgs;
 // 发一次"，多线程只会让其余线程空转（★M-3T-c 后仍成立：读的行数与线程数无关，都是 1 行）；
 // ② NV 的 task 上限是 128（§19.11），1 恒合规。
 [numthreads(1, 1, 1)]
+#ifdef MDI_DIRECT
+// 🔴🔴 S3 减法档临时补丁（债-140 任务 12，跑完即还原）：直派变体——行号来源从 SV_DrawIndex 换成
+// SV_GroupID.x（vkCmdDrawMeshTasksEXT 的 grid X = 段行数，不经 MDI 间接命令）。行表/payload/
+// DispatchMesh 全保留；gcX==0 的行（MDI 下本就不启动 task）在此改为 task 启动后早退。
+void main(uint3 s3GroupID : SV_GroupID)
+#else
 void main(uint drawID : SV_DrawIndex)
+#endif
 {
     // 行表规格常量（口径与对账链 → 文件头；写法 = 函数内 `const uint`，slang 的全局 const 需 static，
     // 照 meshlet.mesh.slang 先例放 main 体内）。
@@ -137,7 +144,15 @@ void main(uint drawID : SV_DrawIndex)
     p.clusterStart = latchedClusterStart; // 🔴 判据验的也是这份拷贝
     p.meshGroupCount = meshGroupCount;    // 债-143 钳制上界（同为 latch 的那份）
 #else
+# ifdef MDI_DIRECT
+    // 🔴 S3 临时（见入口注）：行号 = rowBase + SV_GroupID.x；gcX==0 早退不发 mesh。
+    const uint kS3GroupCountXByteOffset = 0u;  // 行 word[0]（具名常量 = R5 口径，同自证支写法）
+    const uint rowBytes = (mdiTaskPush.rowBase + s3GroupID.x) * kMdiShadowRowStrideBytes;
+    if (mdiShadowArgs.Load(rowBytes + kS3GroupCountXByteOffset) == 0u)
+        return;
+# else
     const uint rowBytes = (mdiTaskPush.rowBase + drawID) * kMdiShadowRowStrideBytes;
+# endif
     const uint meshGroupCount = mdiShadowArgs.Load(rowBytes + kMdiShadowMeshGroupCountByteOffset);
 
     MdiShadowPayload p;
