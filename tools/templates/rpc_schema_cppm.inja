/** 一条端点的路由身份 + 超时 + 说明 + 请求形状（顺序 = schema 记录顺序）。 */
export struct RpcRouteDef {
    RpcRouteId id;
    RpcRouteMethod method;
    std::string_view methodText;  // 上线拼写（"GET"/"POST"），`GET /` 的 routes 数组用它
    std::string_view path;
    std::string_view summary;     // 给文档参考与客户端帮助，不进任何应答体
    uint32_t timeoutMs;           // 帧边界等待超时（传输层 awaitReply 消费）
    bool manualShape;             // true = 形状检查留在处理函数（止损线，见 schema 头部）
    std::span<const RpcFieldDef> requestFields;  // 空 = 该端点不收任何请求字段
};

/** 全部端点（注册顺序与 `GET /` 回包顺序 = 本表顺序 = schema 记录顺序）。 */
export inline constexpr std::array<RpcRouteDef, {{ endpoints | length }}> kRpcRoutes{
{% for e in endpoints %}    RpcRouteDef{RpcRouteId::{{ e.id }}, RpcRouteMethod::{{ e.method | lower }}, "{{ e.method }}", "{{ e.path }}", "{{ e.summary | cpp_escape }}", {{ e.timeout_ms }}u, {% if existsIn(e, "manualShape") %}{{ e.manualShape }}{% else %}false{% endif %}, kRequestFields_{{ e.id }}},
{% endfor %}};

/** 端点条数（消费 = 注册循环的日志读数与单测的覆盖锚）。 */
export inline constexpr size_t kRpcRouteCount = {{ endpoints | length }};

/**
 * 按路径查路由身份。
 * @return nullopt = 该路径不在表里（调用方出 404）；有值 = 命中，进 switch。
 */
export constexpr std::optional<RpcRouteId> rpcRouteByPath(std::string_view path) {
    for (const auto& route : kRpcRoutes) {
        if (route.path == path)
            return route.id;
    }
    return {};
}

/**
 * 按身份取条目。
 * 前提：id 只可能来自 `rpcRouteByPath` 或注册期闭包（两者都从本表取）⟹ 必在表内。
 */
export constexpr const RpcRouteDef& rpcRouteById(RpcRouteId id) {
    return kRpcRoutes[static_cast<size_t>(id)];
}

namespace rpc_schema_detail {

/** 路径唯一性（编译期）：重复路径 = 后一条永远查不到，而"注册了却不可达"不会有任何运行期症状。 */
inline constexpr bool rpcPathsUnique() {
    for (size_t i = 0; i < kRpcRoutes.size(); ++i) {
        for (size_t j = i + 1; j < kRpcRoutes.size(); ++j) {
            if (kRpcRoutes[i].path == kRpcRoutes[j].path)
                return false;
        }
    }
    return true;
}

/** 超时为正（编译期）：0 = 请求必然当场 504，写错一个 0 不该等到运行期才发现。 */
inline constexpr bool rpcTimeoutsPositive() {
    for (const auto& route : kRpcRoutes) {
        if (route.timeoutMs == 0u)
            return false;
    }
    return true;
}

/**
 * 端点内字段名唯一（编译期）：重名 = 未知字段闸门的 `any_of` 只会命中第一条，
 * 后一条的形状声明静默失效（"注册了却不可达"的字段版）。
 */
inline constexpr bool rpcFieldNamesUnique() {
    for (const auto& route : kRpcRoutes) {
        for (size_t i = 0; i < route.requestFields.size(); ++i) {
            for (size_t j = i + 1; j < route.requestFields.size(); ++j) {
                if (route.requestFields[i].name == route.requestFields[j].name)
                    return false;
            }
        }
    }
    return true;
}

/**
 * 声明了形状就必须有文案（编译期）：文案是客户端归因的唯一出口，缺文案的约束 = 约束生效
 * 而调用方只拿到一个空 error 串。schema 里写了 min/max 却忘写 error 就是这个形态。
 */
inline constexpr bool rpcCheckedFieldsHaveError() {
    for (const auto& route : kRpcRoutes) {
        for (const auto& f : route.requestFields) {
            const bool checked = f.required || f.nonEmpty || !f.exclusive.empty()
                || !f.oneOf.empty() || f.minValue.has_value() || f.maxValue.has_value()
                || f.kind != RpcFieldKind::any;
            if (checked && f.error.empty())
                return false;
        }
    }
    return true;
}

/**
 * manualShape 端点不许声明形状（编译期）：那类端点的检查留在处理函数，schema 里再写一份
 * 必填/范围就是**第二份副本**，而它声称的那件事没有任何机器对账（正是本项目反复踩的
 * "看起来已完工的半吊子"）。这条断言把"止损线"从注释变成编译器判据。
 */
inline constexpr bool rpcManualShapesDeclareNothing() {
    for (const auto& route : kRpcRoutes) {
        if (!route.manualShape)
            continue;
        for (const auto& f : route.requestFields) {
            if (f.required || f.nonEmpty || !f.exclusive.empty() || !f.oneOf.empty()
                || f.minValue.has_value() || f.maxValue.has_value()
                || f.kind != RpcFieldKind::any)
                return false;
        }
    }
    return true;
}

}  // namespace rpc_schema_detail

static_assert(rpc_schema_detail::rpcPathsUnique(), "rpc_schema.lua 的 path 有重复");
static_assert(rpc_schema_detail::rpcTimeoutsPositive(), "rpc_schema.lua 的 timeout_ms 必须 > 0");
static_assert(rpc_schema_detail::rpcFieldNamesUnique(), "rpc_schema.lua 某端点的 request.fields 有重名字段");
static_assert(rpc_schema_detail::rpcCheckedFieldsHaveError(),
    "rpc_schema.lua 里声明了形状（kind/required/min/max/nonEmpty/oneOf/exclusive）的字段必须带 error 文案");
static_assert(rpc_schema_detail::rpcManualShapesDeclareNothing(),
    "标了 manualShape 的端点不许在 schema 里声明形状——形状检查留在处理函数，这里只登记字段名");
static_assert(kRpcRoutes.size() == kRpcRouteCount, "生成物内部不一致（模板写坏了？）");

}  // namespace RGL
