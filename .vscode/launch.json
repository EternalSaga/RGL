{
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": [
                {
                    "name": "VK_ADD_LAYER_PATH",
                    "value": "${command:cmake.buildDirectory}/vcpkg_installed/x64-linux-native/share/vulkan/explicit_layer.d"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "ShaderReflection",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/ShaderReflection/ShaderReflection.exe",
            "args": [
                "--type",
                "material_binding",
                "-m",
                "D:/program/RGL/build/shaders/material_bindings/AssimpMaterialBinding.hpp",
                "--material_binding_template",
                "D:/program/RGL/ShaderReflection/templates/assimpmaterial_table.hpp.jinja",
                "-s",
                "D:/program/RGL/ShaderReflection/templates/SamplerRules.lua",
                "-c",
                "D:/program/RGL/configs/shaderRefLogLevel.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": [],
            "console": "externalTerminal"
        },
        {
            "name": "(Windows) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/build",
            "environment": [],
            "console": "externalTerminal"
        },

        {
            "type": "cmake",
            "request": "launch",
            "name": "Debug portfile(s)",
            "cmakeDebugType": "external",
            "pipeName": "\\\\.\\pipe\\vcpkg_ext_portfile_dbg",
            "preLaunchTask": "Debug vcpkg commands"
        }
    ]
}