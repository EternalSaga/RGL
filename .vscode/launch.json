{
    "configurations": [
        {
            "name": "ShaderReflection",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/ShaderReflection/ShaderReflection.exe",
            "args": [
                "-i",
                "D:/program/RGL/build/render_core/shader_systems/generated_shaders/grass_fragment.spv",
                "--type",
                "cpp",
                "-o",
                "D:/program/RGL/build/render_core/shader_systems/generated_shaders/grass_fragment.hpp",
                "-d",
                "D:/program/RGL/ShaderReflection/templates",
                "-c",
                "D:\\program\\RGL\\configs\\shaderRefLogLevel.json",
                "-s",
                "D:/program/RGL/ShaderReflection/templates/SamplerRules.lua"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": [],
            "console": "externalTerminal"
        },
        {
            "name": "(Windows) Launch",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}/build",
            "environment": [],
            "console": "externalTerminal"
        },
        {
            "type": "cmake",
            "request": "launch",
            "name": "Debug portfile(s)",
            "cmakeDebugType": "external",
            "pipeName": "\\\\.\\pipe\\vcpkg_ext_portfile_dbg",
            "preLaunchTask": "Debug vcpkg commands"
        }
    ]
}